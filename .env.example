# Токен бота от @BotFather
TG_TOKEN=ваш_токен_бота

# ID чата или группы, куда отправляются заказы.
# Участники этой группы получают доступ к /admin, бот должен быть в группе
GROUP_ID=ID_вашей_telegram_группы

# PostgreSQL для docker compose (DB_URL в контейнере собирается из этих значений).
# Пароль лучше без символов @ : / ? # — они ломают строку подключения
POSTGRES_USER=shop
POSTGRES_PASSWORD=придумайте_пароль
POSTGRES_DB=shop

# Бэкапы базы (сервис backup в docker compose): раз в сутки, хранятся 7 дней в папке backups/
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=7

# Писать в лог каждый SQL-запрос (только для отладки)
DB_ECHO=false

# DB_URL нужен только при запуске без Docker:
# SQLite (локальный тест):
DB_URL=sqlite+aiosqlite:///./shop.db
# PostgreSQL на этой же машине:
# DB_URL=postgresql+asyncpg://shop:пароль@localhost:5432/shop
